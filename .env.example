# PhoneLight server configuration: copy to .env in the app directory
# (install.sh does this for you). .env is gitignored and never committed.
# systemd loads it via EnvironmentFile=. Restart after editing:
#   sudo systemctl restart phonelight
#
# Format: KEY=value, one per line, no spaces around '='. Lines starting with
# # are comments. No inline comments and no $VAR expansion.
#
# Show settings (universe, start address, fixtures, 8/16-bit, master, loss
# hold/fade, data retention) are NOT here: set them on the admin Settings page.

# ── Web server ───────────────────────────────────────────────────────────────
# Guests open http://<this server>:APP_PORT/ ; the admin is at /admin.
APP_PORT=5420
# Open sockets the one gevent worker accepts (phones + admin pages + spare).
#MAX_CONNECTIONS=4000
# 1 = log every HTTP request to the journal.
#ACCESS_LOG=1
# 1 = behind a reverse proxy (Caddy/nginx for HTTPS later): take the guest's
# IP and scheme from X-Forwarded-For / X-Forwarded-Proto. Leave off otherwise
# (anyone could fake their IP with that header).
#TRUST_PROXY=1

# ── Admin access ─────────────────────────────────────────────────────────────
# There is no admin sign-in yet. Limit /admin to these IPs / networks
# (comma-separated); guests on other addresses get 403 there. Empty = anyone.
#ADMIN_ALLOW=192.168.10.0/24,127.0.0.1

# ── sACN in ──────────────────────────────────────────────────────────────────
# Unicast only (no multicast join). Bind to one interface's IP to listen on
# that network only; 0.0.0.0 = every interface.
#SACN_BIND=0.0.0.0
#SACN_PORT=5568

# ── Database (SQLite for the trial; PostgreSQL later) ────────────────────────
# Relative paths are inside the app directory.
#DB_PATH=data/phonelight.db
